# Copy to .env (git-ignored). Everything is optional locally: docker-compose has working defaults.

MYSQL_ROOT_PASSWORD=

# Signs the login tokens: at least 32 characters. Generate a real one for any public deployment:  openssl rand -hex 32
# The "dev-only" default is refused when SPRING_PROFILES_ACTIVE=prod.
JWT_SECRET=

# First administrator, created while no user exists yet
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@2026!

# Demo agency (cars, clients, contracts, expenses, partners, staff accounts)
DEMO_DATA=true
DEMO_PASSWORD=Rental@2026!

# Browser origin of the web app and its public address (used in password reset e-mails)
CORS_ALLOWED_ORIGINS=http://localhost:4200
WEB_URL=http://localhost:4200

# Optional: e-mail for password resets (Gmail: use an app password, never your real one)
SMTP_USERNAME=
SMTP_PASSWORD=
